NODE_ENV=development
PORT=3000
STRUCTURED_LOGGING=true
OPERATIONS_TOKEN=replace_with_a_long_random_monitoring_token
DATABASE_URL=postgresql://spending_companion:local-development-only@localhost:5432/spending_companion?schema=public

# Create separate Clerk development credentials. Never commit real values.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_ISSUER=https://replace-me.clerk.accounts.dev
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=

# Mobile public configuration belongs in apps/mobile/.env, never this backend file.

# Plaid Sandbox is integrated in Phase 3. Keep secrets backend-only.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=replace_me
PLAID_SECRET=replace_me
PLAID_WEBHOOK_URL=https://replace-me.example.com/v1/webhooks/plaid
PLAID_CLIENT_NAME=Spending Companion
# Optional for OAuth institutions / Android redirect handling.
PLAID_REDIRECT_URI=
PLAID_ANDROID_PACKAGE_NAME=com.susang.spendingcompanion

# Phase 3 token encryption. Local-only placeholder; production uses KMS.
PLAID_TOKEN_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key
