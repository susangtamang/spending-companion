{
  "name": "@spending-companion/reconciliation",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-independent pending-to-posted transaction reconciliation.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src --pool=threads --maxWorkers=1"
  },
  "dependencies": {
    "@spending-companion/contracts": "file:../contracts"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
