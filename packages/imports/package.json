{
  "name": "@spending-companion/imports",
  "version": "0.1.0",
  "private": true,
  "description": "Pure CSV import planning for Spending Companion.",
  "type": "module",
  "main": "./dist/imports/src/index.js",
  "types": "./dist/imports/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/imports/src/index.d.ts",
